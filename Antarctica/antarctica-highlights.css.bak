html{
  scroll-behavior: smooth;
}

body{
    margin: 0;
}

.snap-container{
  height: 100vh;
  overflow-y: scroll;
  scroll-snap-type: y mandatory;
}

.snap-section{
  height: 100vh;
  scroll-snap-align: start;
  scroll-snap-stop: always;

  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
  position: relative;

  text-align: center;
  color: white;
}

.snap-section::after{
  content:"";
  position: absolute;
  inset: 0;
  background: radial-gradient(
    ellipse at center,
    rgba(0,0,0,0.2) 25%,
    rgba(0,0,0,0.45) 75%
  );
  z-index: 0;
  pointer-events: none;
}

.snap-section > * {
  position: relative;
  z-index: 1;
}

.text{
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.5rem;
}

h1{
    font-size: clamp(2.5rem, 6vw, 5rem);
    color: #ffffff;
    letter-spacing: 5px;
    border-radius: 10px;
    text-shadow: 0 0 10px rgba(28, 26, 18, 0.9);
    margin: 0;
    font-family: "Space Grotesk", sans-serif;
}

p{
  font-size: clamp(1.5rem, 6vw, 2rem);
  box-shadow: 0 0 15px rgba(254, 254, 254, 0.9);
  backdrop-filter: blur(1px);
  text-shadow: 0 0 20px rgba(0, 0, 0, 0.98);
  margin: 0;
  padding: 30px;
  height: 250px;

  display: flex;
  align-items: center; 
  justify-content: center; 
  max-width: min(800px, 90vw);
}

.scroll-hint{
  color: rgb(253, 253, 253);
  box-shadow: none;
  backdrop-filter: none;
  text-shadow: 0 1px 3px rgba(128, 118, 118, 0.35);
  border: none;
  margin: 0;
  padding: 0;
  height: auto;
  font-size: clamp(1.25rem, 2.5vw, 2.2rem);
  opacity: 0.8;
  animation: scrollFloat 2s ease-in-out infinite, hintCycle 3s ease-in-out infinite;
  pointer-events: none;
  position: fixed;
  left: 50%;
  bottom: 24px;
  width: max-content;
  text-align: center;
  margin-top: auto;
  letter-spacing: 3px;
  z-index: 4000;
}

@keyframes scrollFloat{
  0%{
    transform: translate(-50%, 0);
    opacity: 0.6;
  }
  50%{
    transform: translate(-50%, 10px);
    opacity: 1;
  }
  100%{
    transform: translate(-50%, 0);
    opacity: 0.6;
  }
}

@keyframes hintCycle{
  /* visible */
  0%,
  40%{
    color: rgba(255,255,255,0.85);
  }

  /* fade out */
  50%{
    color: rgba(199, 199, 199, 0.024);
  }

  /* stay hidden */
  70%{
    color: rgba(199, 199, 199, 0.523);
  }

  /* fade back in */
  100%{
    color: rgba(255,255,255,0.85);
  }
}

